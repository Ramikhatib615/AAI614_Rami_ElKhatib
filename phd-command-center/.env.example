# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon via the Vercel marketplace) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (Auth.js v5, GitHub OAuth) ---
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Comma-separated allowlist. Only these addresses may sign in.
AUTH_ALLOWED_EMAILS="ramikhatib615@gmail.com"

# --- Claude API (needed from phase 4) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_RESEARCH="claude-sonnet-5"
ANTHROPIC_MODEL_WRITING="claude-opus-5"
ANTHROPIC_MODEL_FAST="claude-haiku-4-5"
AI_MONTHLY_BUDGET_USD="25"

# --- Sources ---
# OpenAlex asks for a contact address to put you in its polite pool.
OPENALEX_MAILTO="ramikhatib615@gmail.com"
SEMANTIC_SCHOLAR_API_KEY=""

# --- Jobs ---
CRON_SECRET=""

# --- Private profile values (never stored in git) ---
# Facts declared in data/profile.ts with `valueFrom` resolve from here.
PROFILE_PHONE=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
